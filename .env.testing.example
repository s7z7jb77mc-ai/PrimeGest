# Configuration des tests — copier en .env.testing (non versionné).
# Par défaut SQLite (identique à la CI, aucun secret requis).

APP_ENV=testing
APP_KEY=
APP_DEBUG=true

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Variante MySQL locale (décommenter et renseigner) :
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=primegest_test
# DB_USERNAME=primegest
# DB_PASSWORD=

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BCRYPT_ROUNDS=4
